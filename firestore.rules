rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.isActive == true;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.roleId in ['super_admin', 'hospital_admin', 'org_admin', 'admin'];
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOrgIdInData(orgId) {
      return request.resource.data.orgId == orgId || resource.data.orgId == orgId;
    }

    // ── Organization Tree ────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      // Any signed-in user may CREATE a new organization (Firestore auto-ID);
      // updates and deletes remain restricted to org admins. This avoids the
      // chicken-and-egg where a brand-new org has no member/admin yet.
      allow create: if isSignedIn();
      allow update: if isOrgAdmin(orgId);
      allow delete: if isOrgAdmin(orgId);

      match /departments/{deptId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgAdmin(orgId);

        match /units/{unitId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId);

          // Encounters — the core clinical record
          match /encounters/{encounterId} {
            allow read: if isOrgMember(orgId);
            allow write: if isOrgMember(orgId) && hasOrgIdInData(orgId);

            // Encounter events (timeline)
            match /events/{eventId} {
              allow read: if isOrgMember(orgId);
              allow write: if isOrgMember(orgId);
            }

            // Phase data
            match /phases/{phaseId} {
              allow read: if isOrgMember(orgId);
              allow write: if isOrgMember(orgId);
            }

            // Orders (labs, imaging, prescriptions)
            match /orders/{orderId} {
              allow read: if isOrgMember(orgId);
              allow write: if isOrgMember(orgId);
            }
          }
        }
      }

      // Organization constitutional containers (written by OrganizationEngine.persist)
      // during provisioning. Signed-in users may write while setting up a new org
      // (chicken-and-egg: no member/admin row exists yet); reads stay member-scoped.
      match /identity/{sub} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }
      match /geography/{sub} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }
      match /metadata/{sub} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }
      match /domains/{domainId} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }
      match /facilities/{facilityId} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }
      match /branches/{branchId} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }
      match /buildings/{buildingId} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }
      match /floors/{floorId} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }
      match /history/{eventId} { allow read: if isOrgMember(orgId); allow write: if isSignedIn(); }

      // Organization members
      match /members/{userId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgAdmin(orgId) || (isSignedIn() && request.resource.data.userId == request.auth.uid);
        allow update: if isOrgAdmin(orgId) || (isSignedIn() && request.resource.data.userId == request.auth.uid);
        allow delete: if isOrgAdmin(orgId);
      }

      // Organization memberships (WorkspaceEngine collection group)
      match /memberships/{memberId} {
        allow read: if isSignedIn() && (resource.data.orgId == null || isOrgMember(resource.data.orgId));
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isOrgAdmin(orgId);
      }

      // Campuses & Buildings (FacilityResolver reads)
      match /campuses/{campusId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgAdmin(orgId);

        match /buildings/{buildingId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgAdmin(orgId);
        }
      }

      // Shifts & Shift Assignments (AssignmentResolver reads)
      match /shifts/{shiftId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgAdmin(orgId);
      }
      match /shift_assignments/{assignmentId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgAdmin(orgId);
      }

      // Employments
      match /employments/{employmentId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgAdmin(orgId);
      }

      // Assignments
      match /assignments/{assignmentId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgAdmin(orgId);
      }

      // Organization roles
      match /roles/{roleId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgAdmin(orgId);
      }

      // Analytics & Audit
      match /analytics/{metricId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if isOrgAdmin(orgId);
      }
      match /auditLogs/{logId} {
        allow read: if isOrgAdmin(orgId);
        allow create: if isOrgMember(orgId);
      }

      // Organization patients
      match /patients/{patientId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId) && hasOrgIdInData(orgId);

        match /encounters/{encounterId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId);
        }
        match /lifeline/{eventId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId);
        }
      }
    }

    // ── Top-level identities, persons, professionals (registration/auth) ──
    // Documents are keyed by AMXUID; any signed-in user can write their own docs.
    match /identities/{identityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /persons/{personId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /professional_identities/{professionalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if false; // managed server-side only
    }

    // ── Top-level users (backward compat with client-side writes) ───────
    // Keep readable for account-type checks, but restrict writes
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId) || isSignedIn(); // allow writes for registration + profile updates
    }

    // ── Verifications (per-AMXUID) ───────────────────────────────────────
    match /verifications/{amxUid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // server-side or self
    }

    // ── Workspaces ──────────────────────────────────────────────────
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── Actor core (UAE root — every registrar writes an Actor row) ────
    // Owner-scoped writes; readable by any signed-in user.
    match /actors/{actorId} {
      allow read: if isSignedIn();
      allow write: if isSelf(actorId) || isSignedIn();

      // Preference engine (UPrE) — never device-owned, always the actor.
      match /preferences/{prefKey} {
        allow read: if isSignedIn();
        allow write: if isSelf(actorId);
      }

      // Capabilities (UCE), Consents & Delegations (UCDE) owned by the actor.
      match /capabilities/{capId} {
        allow read: if isSignedIn();
        allow write: if isSelf(actorId);
      }
      match /consents/{consentId} {
        allow read: if isSignedIn();
        allow write: if isSelf(actorId);
      }
      match /delegations/{delegationId} {
        allow read: if isSignedIn();
        allow write: if isSelf(actorId);
      }
    }

    // ── Protocol versions (UPVE) + competency constructs (ULCE) ───────────
    // Read-only from clients; written only by their owning engines/server.
    match /protocolVersions/{versionId} {
      allow read: if isSignedIn();
      allow write: if false; // Protocol Version Engine only
    }
    match /competencyConstructs/{constructId} {
      allow read: if isSignedIn();
      allow write: if false; // Learning & Competency Engine only
    }

    // ── Marketplace (UME) ────────────────────────────────────────────────
    // Modules are capability packs, read-only to clients; installation is an
    // organization-level capability, never arbitrary client writes.
    match /marketplace/modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if false; // Marketplace Engine / constitutional review only
    }
    match /marketplace/installs/{installId} {
      allow read: if isSignedIn() && (resource.data.orgId == null || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // ── Collection Group Rules (for collectionGroup queries) ──────────────
    // These use orgId field on the document for scoping
    match /{path=**}/encounters/{encounterId} {
      allow read: if isSignedIn() && resource.data.orgId != null && isOrgMember(resource.data.orgId);
      allow write: if isSignedIn() && request.resource.data.orgId != null && isOrgMember(request.resource.data.orgId);
    }
    match /{path=**}/events/{eventId} {
      allow read: if isSignedIn() && resource.data.orgId != null && isOrgMember(resource.data.orgId);
      allow write: if isSignedIn() && request.resource.data.orgId != null && isOrgMember(request.resource.data.orgId);
    }
    match /{path=**}/phases/{phaseId} {
      allow read: if isSignedIn() && resource.data.orgId != null && isOrgMember(resource.data.orgId);
      allow write: if isSignedIn() && request.resource.data.orgId != null && isOrgMember(request.resource.data.orgId);
    }
    match /{path=**}/orders/{orderId} {
      allow read: if isSignedIn() && resource.data.orgId != null && isOrgMember(resource.data.orgId);
      allow write: if isSignedIn() && request.resource.data.orgId != null && isOrgMember(request.resource.data.orgId);
    }
    match /{path=**}/lifeline/{eventId} {
      allow read: if isSignedIn() && resource.data.orgId != null && isOrgMember(resource.data.orgId);
      allow write: if isSignedIn() && request.resource.data.orgId != null && isOrgMember(request.resource.data.orgId);
    }
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /{path=**}/memberships/{memberId} {
      allow read: if isSignedIn() && resource.data.organizationId != null && isOrgMember(resource.data.organizationId);
      allow write: if isSignedIn() && request.resource.data.organizationId != null && isOrgMember(request.resource.data.organizationId);
    }

    // ── Legacy Collections (backward compat) ──────────────────────────────
    // These are scoped by orgId field where available, else fall back to signed-in
    match /patients/{document=**} {
      allow read: if isSignedIn() && (resource.data.orgId == null || isOrgMember(resource.data.orgId));
      allow write: if isSignedIn() && (request.resource.data.orgId == null || isOrgMember(request.resource.data.orgId));
    }
    match /prescriptions/{document=**} {
      allow read: if isSignedIn() && (resource.data.orgId == null || isOrgMember(resource.data.orgId));
      allow write: if isSignedIn() && (request.resource.data.orgId == null || isOrgMember(request.resource.data.orgId));
    }
    match /alerts/{document=**} {
      allow read: if isSignedIn() && (resource.data.orgId == null || isOrgMember(resource.data.orgId));
      allow write: if isSignedIn() && (request.resource.data.orgId == null || isOrgMember(request.resource.data.orgId));
    }
    match /clinicalNotes/{document=**} {
      allow read: if isSignedIn() && (resource.data.orgId == null || isOrgMember(resource.data.orgId));
      allow write: if isSignedIn() && (request.resource.data.orgId == null || isOrgMember(request.resource.data.orgId));
    }
    match /appointments/{document=**} {
      allow read: if isSignedIn() && (resource.data.orgId == null || isOrgMember(resource.data.orgId));
      allow write: if isSignedIn() && (request.resource.data.orgId == null || isOrgMember(request.resource.data.orgId));
    }
    match /timeline_events/{document=**} {
      allow read: if isSignedIn() && (resource.data.orgId == null || isOrgMember(resource.data.orgId));
      allow write: if isSignedIn() && (request.resource.data.orgId == null || isOrgMember(request.resource.data.orgId));
    }
  }
}